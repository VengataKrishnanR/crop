# Copy to deploy/sirdb.env and fill in. deploy/sirdb.env is git-ignored.
SIRDB_DB=sirdb
SIRDB_USER=<choose-a-user>
SIRDB_PASSWORD=<choose-a-strong-password>
SIRDB_PORT=55432
# Used by the migrator, loader and tests (same values as above):
SIRDB_DATABASE_URL=postgresql://<user>:<password>@localhost:55432/sirdb
